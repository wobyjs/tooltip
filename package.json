{
    "name": "@woby/tooltip",
    "version": "1.0.30",
    "publishConfig": {
        "access": "public"
    },
    "description": "A powerful tooltip and menu component library for woby.",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.es.js",
    "browser": "./dist/index.umd.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.es.js",
            "require": "./dist/index.cjs.js"
        },
        "./dist/*": "./dist/*",
        "./package.json": "./package.json"
    },
    "type": "module",
    "scripts": {
        "git": "git add . && git commit -m \"Bump version\" && git push",
        "bump": "pnpm version patch --no-git-tag-version",
        "npmjs": "pnpm publish",
        "release": "run-s -c git bump npmjs",
        "css11": "tailwindcss -i ./src/input.css -o ./dist/output.css",
        "declaration": "tsc --build --force --declaration --emitDeclarationOnly --declarationMap  --verbose",
        "declaration:watch": "tsc --build --force --declaration --emitDeclarationOnly --declarationMap  --verbose --watch",
        "watch": "run-p build:watch",
        "build": "run-s build:vite declaration bump",
        "build:web": "vite build --mode web",
        "dev": "vite preview --host",
        "dev:only": "vite --force --mode dev --host",
        "dev1": "run-p dev:only",
        "build:vite": "vite build",
        "build:watch": "vite build --watch",
        "preview": "vite preview --host",
        "icon//": "node ./node_modules/svg2tsx/cli/index.js"
    },
    "keywords": [
        "tooltip",
        "notification",
        "menu",
        "woby",
        "@woby/component"
    ],
    "license": "MIT",
    "peerDependencies": {
        "@woby/styled": "workspace:../styled",
        "@woby/use": "workspace:../use",
        "woby": "workspace:../woby"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.2",
        "concurrently": "^10.0.3",
        "puppeteer": "^25.3.0",
        "style-loader": "^4.0.0",
        "tailwindcss": "^4.3.2",
        "vite": "^8.1.5",
        "vite-plugin-tsconfig": "^2.0.0"
    },
    "author": "Chi Chong <wobyjs@gmail.com>",
    "homepage": "https://github.com/wobyjs/tooltip",
    "repository": {
        "type": "git",
        "url": "git@github.com:wobyjs/tooltip.git"
    },
    "dependencies": {
        "@tailwindcss/postcss": "^4.3.2",
        "autoprefixer": "^10.5.3",
        "postcss": "^8.5.19",
        "typescript": "7.0.2"
    }
}
