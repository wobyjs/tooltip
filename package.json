{
    "name": "@woby/tooltip",
    "version": "1.0.21",
    "publishConfig": {
        "access": "public"
    },
    "description": "A powerful tooltip and menu component library for woby.",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.es.js",
    "browser": "./dist/index.umd.js",
    "types": "./dist/types/index.d.ts",
    "type": "module",
    "scripts": {
        "git": "git add . && git commit -m \"Bump version\" && git push",
        "bump": "pnpm version patch --no-git-tag-version",
        "npmjs": "pnpm publish",
        "release": "run-s -c git bump npmjs",
        "css11": "tailwindcss -i ./src/input.css -o ./dist/output.css",
        "declaration": "tsc --build --force --declaration --emitDeclarationOnly --declarationMap  --verbose",
        "declaration:watch": "tsc --build --force --declaration --emitDeclarationOnly --declarationMap  --verbose --watch",
        "watch": "run-p build:watch",
        "build": "run-s build:vite declaration bump",
        "build:web": "vite build --config=vite.config.web.mts --mode production",
        "dev": "vite preview --config=vite.config.web.mts --host",
        "dev:only": "vite --config=vite.config.web.mts --force --mode dev --host",
        "dev1": "run-p dev:only",
        "build:vite": "vite build",
        "build:watch": "vite build --watch",
        "preview": "vite preview --host",
        "icon//": "node ./node_modules/svg2tsx/cli/index.js"
    },
    "keywords": [
        "tooltip",
        "notification",
        "menu",
        "woby",
        "@woby/component"
    ],
    "license": "MIT",
    "peerDependencies": {
        "@woby/styled": "workspace:../styled",
        "@woby/use": "workspace:../use",
        "woby": "workspace:../woby"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.0",
        "concurrently": "^9.2.1",
        "puppeteer": "^25.0.4",
        "style-loader": "^4.0.0",
        "tailwindcss": "^4.3.0",
        "vite": "^8.0.14",
        "vite-plugin-tsconfig": "^2.0.0"
    },
    "author": "Chi Chong <wobyjs@gmail.com>",
    "homepage": "https://github.com/wobyjs/tooltip",
    "repository": {
        "type": "git",
        "url": "git@github.com:wobyjs/tooltip.git"
    },
    "dependencies": {
        "@tailwindcss/postcss": "^4.3.0",
        "autoprefixer": "^10.5.0",
        "postcss": "^8.5.15",
        "typescript": "6.0.3"
    }
}
